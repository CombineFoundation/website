rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public content collections
    match /events/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow write: if request.auth != null;
      allow update: if request.auth != null || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["comments", "likes", "views"]);
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /splashBanners/{bannerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /mous/{mouId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /teamMembers/{memberId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /annualReports/{reportId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /partners/{partnerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User-submitted records
    match /contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /donations/{donationId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Legacy / unused collections should not be writable from the client.
    match /programs/{programId} {
      allow read: if false;
      allow write: if false;
    }

    match /applications/{applicationId} {
      allow read: if false;
      allow write: if false;
    }

    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
